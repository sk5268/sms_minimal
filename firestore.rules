rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sms/{msgId} {
      // Strictly allow torasfk@gmail.com (you) to read and write messages
      // Also allow authenticated users matching your email or anonymous sync from your trusted device
      allow read, write: if request.auth != null && (
        request.auth.token.email == "torasfk@gmail.com" ||
        request.auth.token.firebase.sign_in_provider == "anonymous"
      );
    }
  }
}
