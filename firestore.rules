rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner's verified Google account. Anonymous sessions are rejected:
    // the web config is public, so "any signed-in user" means anyone.
    // Server-side readers (e.g. Jarvis via the Admin SDK) bypass these rules.
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email == "torasfk@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /sms/{msgId} {
      allow read, write: if isOwner();
    }

    // Everything else stays closed (rules deny by default).
  }
}
